{
  "name": "@mlx-node/core",
  "version": "0.0.8",
  "description": "Internal native bindings - import from @mlx-node/lm or @mlx-node/trl instead",
  "homepage": "https://github.com/mlx-node/mlx-node",
  "bugs": {
    "url": "https://github.com/mlx-node/mlx-node/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mlx-node/mlx-node.git",
    "directory": "packages/core"
  },
  "files": [
    "index.cjs",
    "index.d.cts"
  ],
  "type": "module",
  "main": "./index.cjs",
  "types": "./index.d.cts",
  "exports": {
    ".": {
      "types": "./index.d.cts",
      "import": "./index.cjs",
      "require": "./index.cjs"
    }
  },
  "scripts": {
    "build": "oxnode ./build.ts --release",
    "build:wasm": "oxnode ./build.ts --target wasm32-wasip1-threads --profile wasi",
    "preversion": "oxnode ./build.ts && git add ."
  },
  "devDependencies": {
    "@emnapi/core": "^1.9.1",
    "@emnapi/runtime": "^1.9.1",
    "@emnapi/wasi-threads": "^1.2.0",
    "@napi-rs/cli": "^3.6.2",
    "@oxc-node/cli": "^0.1.0",
    "vite-plus": "catalog:"
  },
  "optionalDependencies": {
    "@mlx-node/core-darwin-arm64": "workspace:*"
  },
  "napi": {
    "binaryName": "mlx-core",
    "targets": [
      "aarch64-apple-darwin",
      "wasm32-wasip1-threads"
    ],
    "wasm": {
      "initialMemory": 16000,
      "maximumMemory": 65536,
      "browser": {
        "fs": false,
        "asyncInit": true
      }
    }
  }
}
