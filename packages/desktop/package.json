  "dependencies": {
    "@mlx-node/dashboard": "workspace:*",
    "@mlx-node/lm": "workspace:*",
    "@mlx-node/server": "workspace:*"
  },
  "devDependencies": {
    "@electron/notarize": "3.1.1",
    "@electron/osx-sign": "2.6.0",
    "@electron/packager": "20.0.4",
    "@napi-rs/image": "1.14.0",
    "@types/node": "catalog:",
    "electron": "43.2.0",
    "vite-plus": "catalog:"
  }
}
