{
  "name": "@mlx-node/dashboard",
  "version": "0.0.11",
  "private": true,
  "description": "Local web dashboard for mlx-node: models, metrics, paged cache",
  "license": "MIT",
  "files": [
    "dist",
    "skills",
    "web"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@mlx-node/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && yarn build:ui",
    "build:ui": "cd ui && vp build",
    "dev": "oxnode scripts/dev-dashboard.ts",
    "dev:fixture": "oxnode scripts/dev-fixture.ts",
    "dev:shots": "oxnode scripts/dev-shots.ts",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@huggingface/hub": "^2.17.10",
    "@mlx-node/agent": "workspace:*",
    "@mlx-node/lm": "workspace:*",
    "@mlx-node/server": "workspace:*",
    "@napi-rs/keyring": "^2.1.2",
    "drizzle-orm": "1.0.0-rc.5-ab785fc"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "clsx": "^2.1.1",
    "happy-dom": "21.0.4",
    "lucide-react": "^1.70.0",
    "motion": "14.12.0",
    "oxc-parser": "^0.157.0",
    "playwright-core": "1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">= 22.19.0"
  }
}
