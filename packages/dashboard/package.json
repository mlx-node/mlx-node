{
  "name": "@mlx-node/dashboard",
  "version": "0.0.7",
  "description": "Local web dashboard for mlx-node: models, sessions, metrics, paged cache",
  "license": "MIT",
  "files": [
    "dist",
    "web"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && yarn build:ui",
    "build:ui": "cd ui && vite build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "@huggingface/hub": "^2.13.2",
    "@mlx-node/agent": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite": "catalog:"
  },
  "engines": {
    "node": ">= 22.19.0"
  }
}
