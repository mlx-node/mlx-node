{
  "name": "@mlx-node/dashboard",
  "version": "0.0.11",
  "private": true,
  "description": "Local web dashboard for mlx-node: models, sessions, metrics, paged cache",
  "license": "MIT",
  "files": [
    "dist",
    "web"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && yarn build:ui",
    "build:ui": "cd ui && vp build",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@huggingface/hub": "^2.16.1",
    "@mlx-node/agent": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "happy-dom": "20.12.0",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">= 22.19.0"
  }
}
