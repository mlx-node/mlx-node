{
  "name": "@mlx-node/browser",
  "version": "0.0.1",
  "description": "MLX inference in the browser via WebGPU + WASM",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "vp exec vite dev",
    "test": "vp test --config vitest.config.ts",
    "build": "vp exec vite build",
    "preview": "vp exec vite preview --host 127.0.0.1",
    "deploy:void": "VITE_MLX_MODEL_URL=/api/model yarn build && vp exec void deploy --project mlx --skip-build",
    "upload:void-model": "node scripts/upload-void-model.mjs"
  },
  "dependencies": {
    "@mlx-node/lm": "workspace:*",
    "@napi-rs/wasm-runtime": "^1.1.2",
    "@streamdown/code": "^1.1.1",
    "@tanstack/react-router": "^1.170.8",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.17.0",
    "lucide-react": "^1.11.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/router-plugin": "^1.168.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "void": "0.9.0"
  }
}
