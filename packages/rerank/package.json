      "@mlx-node/source": "./src/catalog.ts",
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./types": {
      "@mlx-node/source": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./protocol": {
      "@mlx-node/source": "./src/protocol.ts",
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./families": {
      "@mlx-node/source": "./src/families.ts",
      "types": "./dist/families.d.ts",
      "import": "./dist/families.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@mlx-node/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0"
  }
