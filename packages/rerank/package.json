{
  "name": "@mlx-node/rerank",
  "version": "0.0.17",
  "description": "Native reranking on Apple Silicon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mlx-node/mlx-node.git",
    "directory": "packages/rerank"
  },
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@mlx-node/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
