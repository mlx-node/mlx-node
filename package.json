{
  "name": "mlx-node",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/core/npm/*",
    "examples"
  ],
  "type": "module",
  "scripts": {
    "build": "yarn build:native && yarn build:ts",
    "build:native": "yarn workspace @mlx-node/core build",
    "build:ts": "tsc -b",
    "clean": "rm -rf packages/*/dist",
    "lint": "vp lint",
    "format": "vp fmt",
    "test": "vp test",
    "typecheck": "tsc -b",
    "mlx": "oxnode packages/cli/src/cli.ts"
  },
  "devDependencies": {
    "@ast-grep/napi": "^0.51.0",
    "@mlx-node/asr": "workspace:*",
    "@mlx-node/cli": "workspace:*",
    "@mlx-node/internal-tools": "workspace:*",
    "@mlx-node/lm": "workspace:*",
    "@mlx-node/privacy": "workspace:*",
    "@mlx-node/rerank": "workspace:*",
    "@mlx-node/server": "workspace:*",
    "@mlx-node/trl": "workspace:*",
    "@mlx-node/tts": "workspace:*",
    "@mlx-node/vlm": "workspace:*",
    "@napi-rs/cli": "^3.8.6",
    "@napi-rs/simple-git": "^1.1.0",
    "@oxc-node/cli": "^1.0.0",
    "@oxc-node/core": "^1.0.0",
    "@std/toml": "npm:@jsr/std__toml@^1.0.11",
    "@types/node": "^26.4.0",
    "octokit": "^5.0.5",
    "openai": "7.43.0",
    "oxc-parser": "^0.155.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "resolutions": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "packageManager": "yarn@4.18.1"
}
